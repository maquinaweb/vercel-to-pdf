{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node", "bun"]
	},
	"include": [
		"api/**/*",
		"service/**/*",
		"scripts/**/*",
		"test/**/*",
		"src/**/*",
		"public/**/*.ts"
	],
	"exclude": ["node_modules", "dist", "bin"]
}
