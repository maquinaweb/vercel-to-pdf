{
	"name": "vercel-pdf-converter",
	"version": "2.0.0",
	"description": "Vercel serverless function which generates PDFs from webpages using Obscura headless browser.",
	"type": "module",
	"scripts": {
		"dev": "vercel dev",
		"develop": "vercel dev",
		"build": "bun run build:client && bun run typecheck",
		"build:client": "bun build public/main.ts --outfile public/main.js --minify",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"download-obscura": "bun run scripts/download-obscura.ts",
		"package:vendor": "bun run scripts/package-vendor.ts",
		"deploy": "vercel deploy --prod"
	},
	"dependencies": {
		"puppeteer-core": "^25.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"@types/node": "^22.13.0",
		"@vercel/node": "^17.0.0",
		"typescript": "^5.7.3",
		"vercel": "^41.3.2"
	}
}
