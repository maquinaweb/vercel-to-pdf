{
	"name": "vercel-pdf-converter",
	"version": "2.1.0",
	"description": "Vercel serverless function which generates high-fidelity vector PDFs from webpages using Chromium and Puppeteer.",
	"type": "module",
	"scripts": {
		"dev": "vercel dev",
		"develop": "vercel dev",
		"build": "bun run build:client && bun run typecheck",
		"build:client": "bun build public/main.ts --outfile public/main.js --minify",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"deploy": "vercel deploy --prod"
	},
	"dependencies": {
		"@sparticuz/chromium-min": "153.0.0",
		"puppeteer-core": "^25.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"@types/node": "^22.13.0",
		"@vercel/node": "^17.0.0",
		"typescript": "^5.7.3",
		"vercel": "^41.3.2"
	}
}
